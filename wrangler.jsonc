// Configuration Cloudflare : publication depuis le Mac avec `npm run deploy`
// (= `node build.mjs` puis `npx wrangler deploy`).
// Seul le dossier dist/ est publié : il est généré par build.mjs (JS/CSS/HTML
// minifiés, sans commentaires) et ne contient que les fichiers publics.
// Ne jamais modifier dist/ à la main. Ne jamais changer "name" : sinon
// Cloudflare crée un deuxième projet.
{
  "name": "54cutz-site",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "preview_urls": false
}
